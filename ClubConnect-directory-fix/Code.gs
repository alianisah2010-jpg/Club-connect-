/** Google Apps Script, bound to the EXISTING spreadsheet.
 * Deploy as Web app: Execute as Me; Who has access: Anyone.
 * Set Script Properties: SUPABASE_URL and SUPABASE_ANON_KEY.
 * IMPORTANT: The GET endpoint intentionally publishes ONLY approved, verified club fields.
 */
const DATABASE='Club Database',RESPONSES='HTML Form Responses';
function doGet(e){const p=e.parameter||{};const callback=p.callback||'';if(!/^clubconnect_cb_[0-9]{10,20}$/.test(callback))return ContentService.createTextOutput('Invalid callback');try{const sheet=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(DATABASE);const values=sheet.getDataRange().getDisplayValues();const h=values.shift();const idx=x=>h.indexOf(x);const clubs=values.filter(r=>r[idx('Club Name')]&&r[idx('Verification Status')]==='Verified').map(r=>({name:r[idx('Club Name')],category:r[idx('Category')],description:r[idx('Short Description')],days:r[idx('Meeting Day(s)')],time:r[idx('Meeting Time')],location:r[idx('Meeting Location')],join:r[idx('How to Join')],featuredStatus:r[idx('Featured Status')]==='Approved'?'Approved':''}));return ContentService.createTextOutput(callback+'('+JSON.stringify({clubs})+');').setMimeType(ContentService.MimeType.JAVASCRIPT)}catch(err){return ContentService.createTextOutput(callback+'('+JSON.stringify({error:'Could not load clubs',clubs:[]})+');').setMimeType(ContentService.MimeType.JAVASCRIPT)}}
function doPost(e){try{const p=e.parameter||{};const user=verifyUser_(p.accessToken);if(!user.email||!user.email.toLowerCase().endsWith('@overlake.org'))throw Error('School email required');const name=clean_(p.clubName,120),desc=clean_(p.description,800),cat=clean_(p.category,80);if(!name||!desc||!cat)throw Error('Required fields missing');const s=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(RESPONSES);const head=s.getRange(1,1,1,s.getLastColumn()).getDisplayValues()[0];const obj={'Timestamp':new Date(),'School Email':user.email,'Final Club Name':name,'Category':cat,'Short Description':desc,'Meeting Day(s)':clean_(p.meetingDays,100),'Meeting Time':clean_(p.meetingTime,100),'Meeting Location':clean_(p.meetingLocation,120),'How to Join':clean_(p.howToJoin,300),'Featured Requested':p.featuredRequested==='Yes'?'Yes':'No','Featured Status':p.featuredRequested==='Yes'?'Pending':'Not Requested'};const row=head.map(h=>Object.prototype.hasOwnProperty.call(obj,h)?obj[h]:'');const lock=LockService.getScriptLock();lock.waitLock(15000);try{s.appendRow(row)}finally{lock.releaseLock()}return ContentService.createTextOutput('Submitted')}catch(err){console.error(err);return ContentService.createTextOutput('Submission rejected')}}
function clean_(v,n){let s=String(v||'').trim().slice(0,n);if(/^[=+@\-]/.test(s))s="'"+s;return s}
function verifyUser_(token){if(!token)throw Error('No token');const props=PropertiesService.getScriptProperties();const base=props.getProperty('SUPABASE_URL'),key=props.getProperty('SUPABASE_ANON_KEY');if(!base||!key)throw Error('Supabase settings missing');const r=UrlFetchApp.fetch(base.replace(/\/$/,'')+'/auth/v1/user',{headers:{apikey:key,Authorization:'Bearer '+token},muteHttpExceptions:true});if(r.getResponseCode()!==200)throw Error('Invalid session');return JSON.parse(r.getContentText())}
